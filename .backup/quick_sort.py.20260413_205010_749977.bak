def quick_sort(arr):
    """
    快速排序算法实现
    
    Args:
        arr: 待排序的列表
        
    Returns:
        排序后的列表
    """
    if len(arr) <= 1:
        return arr
    
    # 选择基准元素（这里选择第一个元素作为基准）
    pivot = arr[0]
    
    # 分割列表
    left = [x for x in arr[1:] if x <= pivot]  # 小于等于基准的元素
    right = [x for x in arr[1:] if x > pivot]   # 大于基准的元素
    
    # 递归排序并合并结果
    return quick_sort(left) + [pivot] + quick_sort(right)


def quick_sort_inplace(arr, low=0, high=None):
    """
    原地快速排序算法实现（节省空间）
    
    Args:
        arr: 待排序的列表
        low: 起始索引
        high: 结束索引
    """
    if high is None:
        high = len(arr) - 1
    
    if low < high:
        # 分区操作，返回基准元素的最终位置
        pivot_index = partition(arr, low, high)
        
        # 递归排序左半部分
        quick_sort_inplace(arr, low, pivot_index - 1)
        
        # 递归排序右半部分
        quick_sort_inplace(arr, pivot_index + 1, high)


def partition(arr, low, high):
    """
    分区函数，用于原地快速排序
    
    Args:
        arr: 待分区的列表
        low: 起始索引
        high: 结束索引
        
    Returns:
        基准元素的最终位置
    """
    # 选择最后一个元素作为基准
    pivot = arr[high]
    
    # i 是小于基准的元素的边界
    i = low - 1
    
    for j in range(low, high):
        # 如果当前元素小于等于基准
        if arr[j] <= pivot:
            i += 1
            # 交换元素
            arr[i], arr[j] = arr[j], arr[i]
    
    # 将基准放到正确的位置
    arr[i + 1], arr[high] = arr[high], arr[i + 1]
    
    return i + 1


def quick_sort_iterative(arr):
    """
    迭代式快速排序实现（避免递归栈溢出）
    
    Args:
        arr: 待排序的列表
    """
    if len(arr) <= 1:
        return arr
    
    # 使用栈来模拟递归
    stack = [(0, len(arr) - 1)]
    
    while stack:
        low, high = stack.pop()
        
        if low < high:
            pivot_index = partition(arr, low, high)
            
            # 将左右子数组的边界压入栈
            stack.append((low, pivot_index - 1))
            stack.append((pivot_index + 1, high))
    
    return arr


def test_quick_sort():
    """测试快速排序算法"""
    print("=== 快速排序算法测试 ===")
    
    # 测试用例
    test_cases = [
        [3, 6, 8, 10, 1, 2, 1],
        [1, 2, 3, 4, 5],  # 已排序
        [5, 4, 3, 2, 1],  # 逆序
        [],               # 空列表
        [1],              # 单元素
        [1, 1, 1, 1, 1],  # 重复元素
        [9, 7, 5, 11, 12, 2, 14, 3, 10, 6]
    ]
    
    print("\n1. 测试标准快速排序:")
    for i, test_case in enumerate(test_cases):
        original = test_case.copy()
        result = quick_sort(test_case.copy())
        print(f"测试 {i+1}: {original} -> {result}")
        assert result == sorted(original), f"测试失败: {original}"
    
    print("\n2. 测试原地快速排序:")
    for i, test_case in enumerate(test_cases):
        original = test_case.copy()
        arr_copy = test_case.copy()
        quick_sort_inplace(arr_copy)
        print(f"测试 {i+1}: {original} -> {arr_copy}")
        assert arr_copy == sorted(original), f"测试失败: {original}"
    
    print("\n3. 测试迭代式快速排序:")
    for i, test_case in enumerate(test_cases):
        original = test_case.copy()
        arr_copy = test_case.copy()
        result = quick_sort_iterative(arr_copy)
        print(f"测试 {i+1}: {original} -> {result}")
        assert result == sorted(original), f"测试失败: {original}"
    
    print("\n✅ 所有测试通过！")


def performance_test():
    """性能测试"""
    import random
    import time
    
    print("\n=== 性能测试 ===")
    
    # 生成随机数据
    sizes = [100, 1000, 5000, 10000]
    
    for size in sizes:
        arr = [random.randint(1, 1000) for _ in range(size)]
        
        # 测试标准快速排序
        start_time = time.time()
        quick_sort(arr.copy())
        standard_time = time.time() - start_time
        
        # 测试原地快速排序
        start_time = time.time()
        quick_sort_inplace(arr.copy())
        inplace_time = time.time() - start_time
        
        # 测试迭代式快速排序
        start_time = time.time()
        quick_sort_iterative(arr.copy())
        iterative_time = time.time() - start_time
        
        print(f"数据大小: {size}")
        print(f"  标准快速排序: {standard_time:.4f}秒")
        print(f"  原地快速排序: {inplace_time:.4f}秒")
        print(f"  迭代式快速排序: {iterative_time:.4f}秒")
        print()


if __name__ == "__main__":
    # 运行测试
    test_quick_sort()
    
    # 运行性能测试
    performance_test()
    
    # 使用示例
    print("\n=== 使用示例 ===")
    example_data = [64, 34, 25, 12, 22, 11, 90]
    print(f"原始数据: {example_data}")
    
    # 使用标准快速排序
    sorted_data = quick_sort(example_data.copy())
    print(f"排序结果: {sorted_data}")
    
    # 使用原地快速排序
    example_data2 = [64, 34, 25, 12, 22, 11, 90]
    quick_sort_inplace(example_data2)
    print(f"原地排序结果: {example_data2}")